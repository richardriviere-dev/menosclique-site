---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const fmt = (d: Date) => d.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });
const register = "https://app.menosclique.com.br/Register";
---
<Base
  title="Blog — MenosClique | Gestão de clínicas na prática"
  description="Conteúdo prático para quem gerencia clínicas e consultórios: agenda, prontuário eletrônico, financeiro, redução de faltas e mais. Aprenda a organizar sua clínica."
  path="/blog"
>
  <section class="bhero">
    <div class="bhero__bg" aria-hidden="true"></div>
    <div class="container center narrow">
      <span class="eyebrow center-line">Blog</span>
      <h1>Gestão de clínicas, <span class="grad">na prática.</span></h1>
      <p class="lead">Ideias e guias para você organizar a sua clínica, reduzir faltas, cuidar do financeiro e atender melhor — com menos cliques.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="posts">
        {posts.map((p) => (
          <a href={`/blog/${p.id}`} class="post card">
            <div class="post__cover" style={p.data.cover ? `background-image:url(${p.data.cover})` : ""}>
              {!p.data.cover && <span class="post__cat-badge">{p.data.category}</span>}
            </div>
            <div class="post__body">
              <span class="post__meta">{p.data.category} · {fmt(p.data.pubDate)}</span>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <span class="post__go">Ler artigo &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="bcta reveal">
        <div class="bcta__bg" aria-hidden="true"></div>
        <h2>Coloque em prática na sua clínica.</h2>
        <p class="lead">14 dias grátis, sem cartão. Agenda, prontuário e financeiro em um só lugar.</p>
        <a href={register} class="btn btn-primary btn-lg">Criar minha conta grátis</a>
      </div>
    </div>
  </section>

  <style>
    .bhero { position: relative; padding-top: clamp(46px, 6vw, 84px); padding-bottom: clamp(10px, 2vw, 24px); overflow: hidden; }
    .bhero__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(50% 42% at 50% 0%, rgba(34,199,201,.16), transparent 60%), linear-gradient(180deg, #f3fbfb, #fff 72%); }
    .bhero h1 { margin: 16px 0 16px; }

    .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .post { overflow: hidden; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s, border-color .2s; }
    .post:hover { transform: translateY(-5px); box-shadow: var(--shadow); border-color: #cfe8e8; }
    .post__cover { aspect-ratio: 16 / 9; background-size: cover; background-position: center; position: relative; display: grid; place-items: center;
      background-color: var(--bg-mint);
      background-image: linear-gradient(135deg, rgba(34,199,201,.14), rgba(27,103,118,.10)), repeating-linear-gradient(135deg, transparent, transparent 20px, rgba(27,103,118,.04) 20px, rgba(27,103,118,.04) 21px); }
    .post__cat-badge { background: rgba(255,255,255,.9); color: var(--turq-ink); font-weight: 700; font-size: .78rem; padding: 6px 14px; border-radius: 999px; }
    .post__body { padding: 22px 24px 24px; display: flex; flex-direction: column; flex: 1; }
    .post__meta { color: var(--muted); font-size: .82rem; font-weight: 500; }
    .post h2 { font-size: 1.2rem; margin: 8px 0 8px; line-height: 1.2; }
    .post p { font-size: .94rem; flex: 1; }
    .post__go { margin-top: 14px; color: var(--turq-ink); font-weight: 600; font-size: .9rem; }

    .bcta { position: relative; text-align: center; padding: clamp(40px, 5vw, 64px) 30px; border-radius: var(--r-xl); overflow: hidden; color: #eafcfd; }
    .bcta__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(120% 130% at 20% 0%, var(--dark-2), var(--dark) 60%); }
    .bcta::before { content: ""; position: absolute; top: -40%; right: -8%; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(34,199,201,.28), transparent 68%); z-index: -1; }
    .bcta h2 { color: #fff; } .bcta p { color: #a9c6c9; margin: 12px 0 24px; }

    @media (max-width: 900px) { .posts { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .posts { grid-template-columns: 1fr; } }
  </style>
</Base>
