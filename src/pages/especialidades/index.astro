---
import Base from "../../layouts/Base.astro";
import { especialidades, type Grupo } from "../../data/especialidades";

const register = "https://app.menosclique.com.br/Register";
const grupos: Grupo[] = ["Médica", "Odontologia", "Saúde e bem-estar"];
const porGrupo = grupos.map((g) => ({ grupo: g, itens: especialidades.filter((e) => e.grupo === g) }));
---
<Base
  title="Sistema para clínicas por especialidade — MenosClique"
  description="Um sistema de gestão sob medida para cada especialidade: dermatologia, cardiologia, odontologia, psicologia, fisioterapia e muito mais. Agenda, prontuário e financeiro. Teste grátis 14 dias."
  path="/especialidades"
>
  <section class="ehero">
    <div class="ehero__bg" aria-hidden="true"></div>
    <div class="container center narrow">
      <span class="eyebrow center-line">Especialidades</span>
      <h1>Um sistema que fala a língua da <span class="grad">sua especialidade.</span></h1>
      <p class="lead">O prontuário do MenosClique é personalizável — então ele se molda ao jeito de cada especialidade, do consultório de dermatologia à clínica de fisioterapia. Encontre a sua.</p>
      <div class="ehero__cta">
        <a href={register} class="btn btn-primary btn-lg">Começar teste grátis</a>
        <a href="/funcionalidades" class="btn btn-ghost btn-lg">Ver funcionalidades</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {porGrupo.map((g) => (
        <div class="grp reveal">
          <h2 class="grp__title">{g.grupo}</h2>
          <div class="grp__grid">
            {g.itens.map((e) => (
              <a href={`/especialidades/${e.slug}`} class="esp card">
                <h3>Sistema para {e.profissional}</h3>
                <p>{e.especialidade}</p>
                <span class="esp__go">Ver &rarr;</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="ecta reveal">
        <div class="ecta__bg" aria-hidden="true"></div>
        <h2>Não achou a sua especialidade?</h2>
        <p class="lead">O prontuário personalizável do MenosClique atende qualquer especialidade. Experimente grátis por 14 dias.</p>
        <a href={register} class="btn btn-primary btn-lg">Criar minha conta grátis</a>
      </div>
    </div>
  </section>

  <style>
    .ehero { position: relative; padding-top: clamp(46px, 6vw, 84px); padding-bottom: clamp(20px, 3vw, 40px); overflow: hidden; }
    .ehero__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(50% 42% at 50% 0%, rgba(34,199,201,.16), transparent 60%), linear-gradient(180deg, #f3fbfb, #fff 72%); }
    .ehero h1 { margin: 16px 0 16px; }
    .ehero__cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 24px; }

    .grp { margin-bottom: 48px; }
    .grp__title { font-size: 1.3rem; padding-bottom: 12px; border-bottom: 2px solid var(--line); margin-bottom: 22px; }
    .grp__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .esp { padding: 20px 22px; display: flex; flex-direction: column; gap: 3px; transition: transform .2s, box-shadow .2s, border-color .2s; }
    .esp:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: #cfe8e8; }
    .esp h3 { font-size: 1.04rem; }
    .esp p { font-size: .88rem; color: var(--muted); }
    .esp__go { margin-top: 10px; color: var(--turq-ink); font-weight: 600; font-size: .9rem; }

    .ecta { position: relative; text-align: center; padding: clamp(40px, 5vw, 64px) 30px; border-radius: var(--r-xl); overflow: hidden; color: #eafcfd; }
    .ecta__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(120% 130% at 20% 0%, var(--dark-2), var(--dark) 60%); }
    .ecta::before { content: ""; position: absolute; top: -40%; right: -8%; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(34,199,201,.28), transparent 68%); z-index: -1; }
    .ecta h2 { color: #fff; } .ecta p { color: #a9c6c9; margin: 12px 0 24px; }

    @media (max-width: 860px) { .grp__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .grp__grid { grid-template-columns: 1fr; } .ehero__cta .btn { flex: 1; } }
  </style>
</Base>
