---
import Base from "../../layouts/Base.astro";
import ScreenFrame from "../../components/ScreenFrame.astro";
import { especialidades } from "../../data/especialidades";
import { especialidadesConteudo } from "../../data/especialidades-content";

export function getStaticPaths() {
  return especialidades.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
const register = "https://app.menosclique.com.br/Register";

const related = especialidades.filter((x) => x.grupo === e.grupo && x.slug !== e.slug).slice(0, 6);

// Conteúdo único desta especialidade (intro, recursos, fluxo, FAQ próprio).
const c = especialidadesConteudo[e.slug];

// Recursos enquadrados p/ a especialidade (fonte única no arquivo de conteúdo);
// fallback genérico só por segurança, caso um slug ainda não tenha conteúdo.
const recursos = c?.recursos ?? [
  { t: "Agenda inteligente", d: `Agendamentos, recorrência e bloqueios — e menos faltas com confirmação por WhatsApp.` },
  { t: "Prontuário do seu jeito", d: `Modelos com os campos que a ${e.especialidade.toLowerCase()} pede, com adendos e histórico completo.` },
  { t: "Financeiro e repasse", d: `Cobranças, pacotes e repasse calculados automaticamente por atendimento.` },
  { t: "Documentos em PDF", d: `Receituário, atestado, termo e recibo prontos a partir de modelos.` },
];

// FAQ específico da especialidade + 2 perguntas transversais (preço e teste).
const faqsGerais = [
  { q: "Tem teste grátis?", a: "Tem: 14 dias grátis, com todas as funcionalidades e sem precisar de cartão de crédito." },
  { q: "Quanto custa?", a: "Os planos começam em R$ 69,90 por mês (Profissional). Todas as funcionalidades estão em todos os planos — você escolhe pelo número de profissionais." },
];
const faqs = [...(c?.faqs ?? []), ...faqsGerais];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<Base
  title={`Sistema para ${e.profissional} — MenosClique`}
  description={`Sistema para ${e.especialidade.toLowerCase()}: agenda, prontuário personalizável, financeiro e documentos em PDF num só lugar. Teste grátis 14 dias, sem cartão.`}
  path={`/especialidades/${e.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <section class="ehero">
    <div class="ehero__bg" aria-hidden="true"></div>
    <div class="container ehero__in">
      <div class="ehero__copy">
        <span class="eyebrow">Sistema para {e.especialidade.toLowerCase()}</span>
        <h1>O sistema para <span class="grad">{e.profissional}</span> que cabe na sua rotina.</h1>
        <p class="lead">{e.angulo}</p>
        <div class="ehero__cta">
          <a href={register} class="btn btn-primary btn-lg">Começar teste grátis</a>
          <a href="/precos" class="btn btn-ghost btn-lg">Ver planos</a>
        </div>
        <div class="trustline" style="margin-top:22px">
          <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>14 dias grátis</span>
          <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Sem cartão</span>
          <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Migração assistida</span>
        </div>
      </div>
      <div class="ehero__art">
        <ScreenFrame label={`Prontuário de ${e.especialidade.toLowerCase()}`} src="/screens/prontuario.png" eager />
      </div>
    </div>
  </section>

  <!-- DOR → SOLUÇÃO -->
  <section class="section-sm">
    <div class="container solve reveal">
      <div class="solve__card">
        <span class="tag">O desafio</span>
        <p>{e.dor}</p>
      </div>
      <svg class="solve__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      <div class="solve__card solve__card--sol">
        <span class="tag">Com o MenosClique</span>
        <p>{e.destaque}</p>
      </div>
    </div>
  </section>

  <!-- INTRO (conteúdo único da especialidade) -->
  {c?.intro?.length && (
    <section class="section-sm">
      <div class="container narrow intro reveal">
        <span class="eyebrow center-line">Feito para a rotina da {e.especialidade.toLowerCase()}</span>
        <h2>Por que o MenosClique combina com a <span class="grad">{e.especialidade.toLowerCase()}.</span></h2>
        {c.intro.map((p) => <p class="intro__p">{p}</p>)}
      </div>
    </section>
  )}

  <!-- RECURSOS (enquadrados p/ a especialidade) -->
  <section class="section">
    <div class="container">
      <div class="center narrow reveal">
        <span class="eyebrow center-line">Tudo que a sua prática precisa</span>
        <h2>Recursos que a {e.especialidade.toLowerCase()} usa <span class="grad">de verdade.</span></h2>
      </div>
      <div class="ben-grid">
        {recursos.map((b) => (
          <div class="ben card reveal">
            <span class="ben__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg></span>
            <div><h3>{b.t}</h3><p>{b.d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FLUXO (como funciona no dia a dia) -->
  {c?.fluxo?.length && (
    <section class="section-sm bg-alt">
      <div class="container">
        <div class="center narrow reveal" style="margin-bottom:34px">
          <span class="eyebrow center-line">Como funciona no seu dia</span>
          <h2>Do agendamento ao recebimento, <span class="grad">sem retrabalho.</span></h2>
        </div>
        <ol class="flux reveal">
          {c.fluxo.map((step, i) => (
            <li class="flux__item">
              <span class="flux__n">{i + 1}</span>
              <p>{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- PRONTUÁRIO SPOTLIGHT -->
  <section class="section-sm">
    <div class="container espot reveal">
      <div class="espot__text">
        <span class="tag">Prontuário personalizável</span>
        <h2>Um prontuário com a cara da <span class="grad">{e.especialidade.toLowerCase()}.</span></h2>
        <p class="lead">Monte os modelos com as seções e campos que você usa de verdade — nada de formulário genérico. Registre adendos, recupere o histórico e atenda com mais foco no paciente.</p>
        <a href="/funcionalidades#prontuario" class="btn btn-dark">Ver o prontuário</a>
      </div>
      <div class="espot__art"><ScreenFrame label={`Modelo de ${e.especialidade.toLowerCase()}`} src="/screens/prontuario.png" /></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow">
      <div class="center reveal" style="margin-bottom:36px">
        <span class="eyebrow center-line">Perguntas frequentes</span>
        <h2>Sobre o MenosClique para {e.especialidade.toLowerCase()}</h2>
      </div>
      <div class="faq-list reveal">
        {faqs.map((f) => (
          <details class="faq"><summary>{f.q}<span class="faq__i"></span></summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELACIONADAS -->
  {related.length > 0 && (
    <section class="section-sm bg-alt">
      <div class="container">
        <h3 class="rel__title">Veja também</h3>
        <div class="rel">
          {related.map((r) => <a href={`/especialidades/${r.slug}`} class="rel__link">Sistema para {r.profissional}</a>)}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section-sm">
    <div class="container">
      <div class="ecta reveal">
        <div class="ecta__bg" aria-hidden="true"></div>
        <h2>Experimente na sua {e.especialidade.toLowerCase()} por 14 dias.</h2>
        <p class="lead">Grátis, sem cartão de crédito, com migração assistida dos seus pacientes.</p>
        <a href={register} class="btn btn-primary btn-lg">Criar minha conta grátis</a>
      </div>
    </div>
  </section>

  <style>
    .ehero { position: relative; padding-top: clamp(40px, 5vw, 72px); padding-bottom: clamp(30px, 4vw, 56px); overflow: hidden; }
    .ehero__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(55% 50% at 85% 5%, rgba(34,199,201,.16), transparent 60%), linear-gradient(180deg, #f3fbfb, #fff 65%); }
    .ehero__in { display: grid; grid-template-columns: 1fr 1.1fr; gap: 52px; align-items: center; }
    .ehero h1 { margin: 16px 0 16px; }
    .ehero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }

    .solve { display: flex; align-items: stretch; gap: 20px; }
    .solve__card { flex: 1; background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); padding: 24px 26px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 10px; }
    .solve__card p { color: var(--ink); font-size: 1.05rem; }
    .solve__card--sol { border-color: var(--turq); background: linear-gradient(180deg, #fff, var(--bg-mint)); }
    .solve__arrow { width: 34px; flex-shrink: 0; align-self: center; color: var(--turq-deep); }

    /* Intro em prosa — conteúdo único da especialidade */
    .intro { text-align: center; }
    .intro h2 { margin: 14px 0 20px; }
    .intro__p { color: var(--ink-soft); font-size: 1.06rem; line-height: 1.75; max-width: 62ch; margin: 0 auto 16px; text-align: left; }

    .ben-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 44px; }
    .ben { display: flex; gap: 16px; padding: 22px 24px; align-items: flex-start; }
    .ben__ic { flex-shrink: 0; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: var(--bg-mint); border: 1px solid #d9efef; color: var(--turq-deep); }
    .ben__ic svg { width: 20px; height: 20px; }
    .ben h3 { font-size: 1.08rem; margin-bottom: 5px; }
    .ben p { font-size: .95rem; }

    /* Fluxo — passos numerados */
    .flux { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; counter-reset: none; }
    .flux__item { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); padding: 22px 20px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 14px; }
    .flux__n { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--turq-deep); color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 1rem; }
    .flux__item p { color: var(--ink); font-size: .96rem; line-height: 1.55; }

    .bg-alt { background: var(--bg-soft); }
    .espot { display: grid; grid-template-columns: 1fr 1.2fr; gap: 50px; align-items: center; }
    .espot h2 { margin: 14px 0 14px; }

    .faq-list { display: grid; gap: 12px; }
    .faq { background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 4px 22px; box-shadow: var(--shadow-sm); }
    .faq summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; padding: 18px 0; font-weight: 600; color: var(--ink); font-family: var(--font-display); list-style: none; }
    .faq summary::-webkit-details-marker { display: none; }
    .faq__i { position: relative; flex-shrink: 0; width: 20px; height: 20px; }
    .faq__i::before, .faq__i::after { content: ""; position: absolute; background: var(--turq-deep); border-radius: 2px; }
    .faq__i::before { top: 9px; left: 2px; width: 16px; height: 2px; }
    .faq__i::after { top: 2px; left: 9px; width: 2px; height: 16px; transition: transform .25s; }
    .faq[open] .faq__i::after { transform: scaleY(0); }
    .faq p { padding: 0 0 20px; color: var(--ink-soft); }

    .rel__title { font-size: 1rem; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 16px; }
    .rel { display: flex; flex-wrap: wrap; gap: 10px; }
    .rel__link { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; font-size: .92rem; font-weight: 500; color: var(--ink-soft); transition: .18s; }
    .rel__link:hover { border-color: var(--turq); color: var(--turq-ink); }

    .ecta { position: relative; text-align: center; padding: clamp(40px, 5vw, 64px) 30px; border-radius: var(--r-xl); overflow: hidden; color: #eafcfd; }
    .ecta__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(120% 130% at 20% 0%, var(--dark-2), var(--dark) 60%); }
    .ecta::before { content: ""; position: absolute; top: -40%; right: -8%; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(34,199,201,.28), transparent 68%); z-index: -1; }
    .ecta h2 { color: #fff; } .ecta p { color: #a9c6c9; margin: 12px 0 24px; }

    @media (max-width: 980px) {
      .ehero__in { grid-template-columns: 1fr; gap: 36px; }
      .ben-grid { grid-template-columns: 1fr; }
      .flux { grid-template-columns: repeat(2, 1fr); }
      .espot { grid-template-columns: 1fr; gap: 30px; }
      .solve { flex-direction: column; }
      .solve__arrow { transform: rotate(90deg); }
    }
    @media (max-width: 560px) {
      .flux { grid-template-columns: 1fr; }
      .intro__p { font-size: 1rem; }
    }
  </style>
</Base>
