---
import Base from "../../layouts/Base.astro";
import { concorrentes } from "../../data/concorrentes";
const register = "https://app.menosclique.com.br/Register";
---
<Base
  title="Alternativas a sistemas para clínicas — MenosClique"
  description="Compare o MenosClique com outros sistemas para clínicas: iClinic, Feegow, Amplimed e mais. Simples, completo e com preço justo. Teste grátis 14 dias, sem cartão."
  path="/alternativas"
>
  <section class="ahero">
    <div class="ahero__bg" aria-hidden="true"></div>
    <div class="container center narrow">
      <span class="eyebrow center-line">Compare</span>
      <h1>Pensando em trocar de <span class="grad">sistema?</span></h1>
      <p class="lead">Se você já usa outro sistema para clínicas e sente que ele é complicado ou caro demais, veja por que tantas clínicas escolhem a simplicidade do MenosClique — e como é fácil migrar.</p>
      <div class="ahero__cta">
        <a href={register} class="btn btn-primary btn-lg">Testar grátis por 14 dias</a>
        <a href="/precos" class="btn btn-ghost btn-lg">Ver preços</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="center" style="margin-bottom:36px">Escolha com quem comparar</h2>
      <div class="cmp-grid">
        {concorrentes.map((c) => (
          <a href={`/alternativas/${c.slug}`} class="cmp card">
            <h3>MenosClique <span>vs</span> {c.nome}</h3>
            <p>Ver por que o MenosClique é uma alternativa ao {c.nome}</p>
            <span class="cmp__go">Comparar &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="ecta reveal">
        <div class="ecta__bg" aria-hidden="true"></div>
        <h2>A melhor comparação é testar.</h2>
        <p class="lead">14 dias grátis, sem cartão, com migração assistida dos seus pacientes.</p>
        <a href={register} class="btn btn-primary btn-lg">Criar minha conta grátis</a>
      </div>
    </div>
  </section>

  <style>
    .ahero { position: relative; padding-top: clamp(46px, 6vw, 84px); padding-bottom: clamp(20px, 3vw, 40px); overflow: hidden; }
    .ahero__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(50% 42% at 50% 0%, rgba(34,199,201,.16), transparent 60%), linear-gradient(180deg, #f3fbfb, #fff 72%); }
    .ahero h1 { margin: 16px 0 16px; }
    .ahero__cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 24px; }

    .cmp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .cmp { padding: 24px 24px; display: flex; flex-direction: column; gap: 6px; transition: transform .2s, box-shadow .2s, border-color .2s; }
    .cmp:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: #cfe8e8; }
    .cmp h3 { font-size: 1.12rem; }
    .cmp h3 span { color: var(--muted); font-weight: 500; font-size: .9rem; }
    .cmp p { font-size: .9rem; color: var(--muted); }
    .cmp__go { margin-top: 10px; color: var(--turq-ink); font-weight: 600; font-size: .9rem; }

    .ecta { position: relative; text-align: center; padding: clamp(40px, 5vw, 64px) 30px; border-radius: var(--r-xl); overflow: hidden; color: #eafcfd; }
    .ecta__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(120% 130% at 20% 0%, var(--dark-2), var(--dark) 60%); }
    .ecta::before { content: ""; position: absolute; top: -40%; right: -8%; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(34,199,201,.28), transparent 68%); z-index: -1; }
    .ecta h2 { color: #fff; } .ecta p { color: #a9c6c9; margin: 12px 0 24px; }

    @media (max-width: 860px) { .cmp-grid { grid-template-columns: 1fr; } .ahero__cta .btn { flex: 1; } }
  </style>
</Base>
